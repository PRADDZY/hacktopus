AUTH_REQUIRED=true
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_SECRET=<supabase-jwt-secret>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
AUTH_AUDIENCE=authenticated
AUTH_ROLE_CLAIM=https://fairlens.ai/roles
AUTH_ADMIN_ROLES=admin
AUTH_JWT_ALGORITHMS=HS256
SUPABASE_REST_SCHEMA=public
RISK_APPROVAL_THRESHOLD=0.55
MODEL_VERSION=worker-baseline-v1
WORKER_SCORING_FALLBACK_ENABLED=false
IDEMPOTENCY_TTL_SECONDS=86400
MODEL_SCORING_ENDPOINT=https://<ml-service-endpoint>/predict
# MODEL_SCORING_TOKEN=<optional-ml-service-bearer-token>
FEATURE_EXTRACTION_ENDPOINT=https://<ml-service-endpoint>/featureize/statement
# FEATURE_EXTRACTION_TOKEN=<optional-feature-extraction-bearer-token>
MODAL_EXTRACTION_ENDPOINT=https://<modal-endpoint>/extract
# MODAL_EXTRACTION_TOKEN=<optional-modal-bearer-token>
EXTRACTION_CALLBACK_SECRET=<shared-callback-secret>
# AI_ASSISTANT_ENDPOINT=https://<assistant-endpoint>/query
# AI_ASSISTANT_TOKEN=<optional-assistant-bearer-token>
# OPENROUTER_API_KEY=<openrouter-api-key>
# OPENROUTER_PRIMARY_MODEL=<provider/model>
# OPENROUTER_FALLBACK_MODEL=<provider/model>
# OPENROUTER_SITE_URL=https://<frontend-domain>
# OPENROUTER_APP_NAME=FairLens Demo

# Optional Auth0 fallback mode (leave unset when using Supabase auth):
# AUTH_ISSUER_BASE_URL=https://<your-auth0-domain>/
# AUTH_AUDIENCE=<your-auth0-api-audience>
# AUTH_JWKS_URL=https://<your-auth0-domain>/.well-known/jwks.json
# AUTH_SHARED_SECRET=<local-dev-only-secret>
